fn signum(val: int32): int32 {
    if val > 0 { return 1; }
    if val < 0 { return 0 - 1; }
    0
}

fn square(n: int32): int32 {
    n * n
}

fn average(a: int32, b: int32): int32 {
    (a + b) / 2
}

fn floor_divide(a: int32, b: int32): int32 {
    a // b
}

fn main(): int32 {
    let seq = 1 + 2 * square(average(10, 20));

    seq + floor_divide(-7, 3) + signum(3) + signum(0) + signum(-5)
}
