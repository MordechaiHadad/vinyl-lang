# Custom types showcase: tuple-structs, whole-value assignment, equality
# Run: vinyl run examples/custom_types.vn
tuple Vec2 (int, int)

tuple Triple (int, int, int)

struct Pair {
    a:int,
    b:int,
}

struct Big {
    x:int,
    y:int,
    z:int,
}

struct FloatValue {
    value:float,
}

enum Result {
    Ok(int),
    Err,
}
# --- Tuple-struct construction, field access, params, returns ---
fn make_vec2(): Vec2 {
    Vec2(3, 4)
}

fn tuple_struct_field_access(): int {
    let p = Vec2(10, 20);
    p.0 + p.1
}

fn tuple_struct_param(v: Vec2): int {
    v.0 * v.1
}

fn tuple_struct_return(): int {
    let v = make_vec2();
    v.0 + v.1
}
# --- Whole-value assignment for aggregates larger than one register ---
fn whole_struct_assignment(): int {
    let mut source = Big{x:1,y:2,z:3};
    let mut dest = Big{x:9,y:9,z:9};
    dest = source;
    dest.x + dest.y + dest.z
}

fn assignment_copies_value(): int {
    let mut source = Big{x:1,y:2,z:3};
    let mut dest = Big{x:9,y:9,z:9};
    dest = source;
    source.x = 100;
    dest.x
}

fn tuple_struct_whole_assignment(): int {
    let mut source = Triple(1, 2, 3);
    let mut dest = Triple(9, 9, 9);
    dest = source;
    dest.0 + dest.1 + dest.2
}
# --- Equality for custom types: structs, tuples, enums, arrays ---
fn struct_equality(): int {
    let a = Pair{a:1,b:2};
    let b = Pair{a:1,b:2};
    let c = Pair{a:1,b:3};
    let same = if a == b {
        1
    } else {
        0
    };
    let different = if a == c {
        1
    } else {
        0
    };
    same + different
}

fn tuple_struct_equality(): int {
    let same = if Vec2(1, 2) == Vec2(1, 2) {
        1
    } else {
        0
    };
    let different = if Vec2(1, 2) == Vec2(1, 3) {
        1
    } else {
        0
    };
    same + different
}

fn enum_equality(): int {
    let ok = Result::Ok(5);
    let same = if ok == Result::Ok(5) {
        1
    } else {
        0
    };
    let different = if ok == Result::Ok(6) {
        1
    } else {
        0
    };
    let error = if ok == Result::Err() {
        1
    } else {
        0
    };
    same + different + error
}

fn array_equality(): int {
    let a: [int;2] = [1,2];
    let b: [int;2] = [1,2];
    let c: [int;2] = [1,3];
    let same = if a == b {
        1
    } else {
        0
    };
    let different = if a == c {
        1
    } else {
        0
    };
    same + different
}
# IEEE float semantics inside aggregates:
# NaN is never equal to itself, but -0.0 equals 0.0.
fn float_aggregate_equality(): int {
    let nan_equal = if FloatValue{value:0.0 / 0.0} == FloatValue{value:0.0 / 0.0} {
        1
    } else {
        0
    };
    let zero_equal = if FloatValue{value:0.0} == FloatValue{value:-0.0} {
        1
    } else {
        0
    };
    nan_equal + zero_equal
}

fn main() {
    let a = tuple_struct_field_access();
    let b = tuple_struct_param(Vec2(3, 4));
    let c = tuple_struct_return();
    let d = whole_struct_assignment();
    let e = assignment_copies_value();
    let f = tuple_struct_whole_assignment();
    let g = struct_equality();
    let h = tuple_struct_equality();
    let i = enum_equality();
    let j = array_equality();
    let k = float_aggregate_equality();

    println(a + b + c + d + e + f + g + h + i + j + k);
}
