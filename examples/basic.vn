# Vinyl language examples
# Run: vinyl run examples/basic.vn

# --- Functions with explicit return ---

fn abs(n: int): int {
    if n < 0 { -n } else { n }
}

fn signum(val: int): int {
    if val > 0 { 1 }
    else if val < 0 { -1 }
    else { 0 }
}

# --- Functions with implicit return (trailing expression, no ;) ---

fn square(n: int): int {
    n * n
}

fn average(a: int, b: int): int {
    (a + b) / 2
}

# --- Floor division (//) truncates toward negative infinity ---

fn floor_divide(a: int, b: int): int {
    a // b
}

fn floor_sum(): int {
    7 // 3 + (-7) // 3 + 7 // (-3) + (-7) // (-3)
}

# --- Type inference: integer literals adapt to the return type ---

fn four(): int {
    4
}

fn eight(): int {
    8
}

# --- If / else control flow ---

fn max(a: int, b: int): int {
    if a > b { a } else { b }
}

# --- Nested if ---

fn classify(n: int): int {
    if n > 100 { 2 }
    else if n > 0 { 1 }
    else if n < 0 { -1 }
    else { 0 }
}

# --- Bitwise and shift operators ---

fn bitwise_demo(x: int, y: int): int {
    (x & y) + (x | y) + (x ^ y) + (x << 1) + (y >> 1)
}

# --- Logical operators ---

fn both_nonzero(a: int, b: int): int {
    if a != 0 && b != 0 { return 1; }
    0
}

# --- Main: ties everything together ---

fn main(): int {
    let a = abs(-5);
    let s = signum(-3) + signum(0) + signum(7);
    let sq = square(average(10, 20));
    let fd = floor_divide(7, 3);
    let fs = floor_sum();
    let ft = four();
    let et = eight();
    let m = max(100, 200);
    let c = classify(150) + classify(50) + classify(-10);
    let bx = bitwise_demo(6, 3);
    let lo = both_nonzero(3, 0);

    a + s + sq + fd + fs + ft + et + m + c + bx + lo
}
