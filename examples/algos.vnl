# Common Algorithms in Vinyl
# Run: vinyl run examples/algorithms.vnl

# --- 1. Fast Exponentiation ---

fn power(base: int, exp: int): int {
    if exp == 0 { 1 }
    else if exp % 2 == 0 {
        let half = power(base, exp / 2);
        half * half
    } else {
        base * power(base, exp - 1)
    }
}

# --- 2. Integer Square Root (Newton-Raphson) ---

fn isqrt(n: int): int {
    if n < 0 { 0 - 1 }
    else if n == 0 { 0 }
    else {
        let mut x = n;
        let mut y = (x + 1) / 2;
        while y < x {
            x = y;
            y = (x + n / x) / 2;
        }
        x
    }
}

# --- 3. Primality Test (Trial Division) ---

fn is_prime(n: int): int {
    if n <= 1 { 0 }
    else if n <= 3 { 1 }
    else if n % 2 == 0 { 0 }
    else if n % 3 == 0 { 0 }
    else {
        let mut i = 5;
        let mut prime = 1;
        while i * i <= n {
            if n % i == 0 {
                prime = 0;
                break;
            } else if n % (i + 2) == 0 {
                prime = 0;
                break;
            }
            i = i + 6;
        }
        prime
    }
}

# --- 4. Extended Euclidean Algorithm ---

fn ext_gcd(a: int, b: int, x: &int, y: &int): int {
    if b == 0 {
        x = 1;
        y = 0;
        a
    } else {
        let mut x1 = 0;
        let mut y1 = 0;
        let d = ext_gcd(b, a % b, &x1, &y1);
        x = y1;
        y = x1 - y1 * (a / b);
        d
    }
}

# --- 5. Integer Digit Reversal ---

fn reverse_digits(n: int): int {
    let mut num = n;
    let mut rev = 0;
    while num > 0 {
        rev = rev * 10 + (num % 10);
        num = num / 10;
    }
    rev
}

# --- 6. Population Count / Hamming Weight ---

fn popcount(n: int): int {
    let mut count = 0;
    let mut temp = n;
    while temp > 0 {
        if temp % 2 == 1 {
            count = count + 1;
        }
        temp = temp / 2;
    }
    count
}

# --- 7. Binary Search Square Root ---

fn binary_search_sqrt(n: int): int {
    let mut low = 0;
    let mut high = n;
    let mut ans = 0;

    while low <= high {
        let mid = low + (high - low) / 2;
        if mid * mid <= n {
            ans = mid;
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    ans
}

# --- Main Driver ---

fn main(): int {
    let pow_res = power(2, 10);               # 1024
    let sqrt_res = isqrt(144);                 # 12
    let prime_res = is_prime(29);              # 1
    
    let mut x_coef = 0;
    let mut y_coef = 0;
    let gcd_res = ext_gcd(240, 46, &x_coef, &y_coef); # 2

    let rev_res = reverse_digits(12345);       # 54321
    let pop_res = popcount(255);               # 8
    let bs_sqrt = binary_search_sqrt(50);      # 7

    pow_res + sqrt_res + prime_res + gcd_res + x_coef + y_coef + rev_res + pop_res + bs_sqrt
}
