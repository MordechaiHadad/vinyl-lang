# Char type examples
# Run: vinyl run examples/chars.vn

fn is_letter(c: char): int {
    if c >= 'a' && c <= 'z' { 1 } else { 0 }
}

fn is_digit(c: char): int {
    if c >= '0' && c <= '9' { 1 } else { 0 }
}

fn main() {
    let a = is_letter('m');
    let b = is_letter('Z');
    let c = is_digit('7');
    let d = is_digit('x');

    println(a + b + c + d);
}
